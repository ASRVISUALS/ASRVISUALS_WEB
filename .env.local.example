# Keep the API key server-side. The backend accepts this as YOUTUBE_API_KEY.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Optional playlist IDs. Playlist titles are discovered automatically when these are blank.
YOUTUBE_PLAYLIST_COMMERCIAL=
YOUTUBE_PLAYLIST_WEDDINGS=
YOUTUBE_PLAYLIST_MUSIC_VIDEOS=
YOUTUBE_PLAYLIST_CORPORATE=
YOUTUBE_PLAYLIST_REELS=