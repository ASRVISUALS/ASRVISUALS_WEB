{
  "version": 2,
  "env": {
    "NODE_ENV": "production"
  },
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "memory": 1024
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/sitemap/(.*)",
      "dest": "backend/api/index.js",
      "headers": {
        "Cache-Control": "public, max-age=43200, s-maxage=43200"
      }
    },
    {
      "src": "/sitemap/(.*)",
      "dest": "backend/api/index.js",
      "headers": {
        "Cache-Control": "public, max-age=43200, s-maxage=43200"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/api/index.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "frontend/static/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)\\.js",
      "dest": "frontend/$1.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)\\.css",
      "dest": "frontend/$1.css",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)\\.woff2",
      "dest": "frontend/$1.woff2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)\\.(webp|avif|png|jpe?g|gif|svg|ico)",
      "dest": "frontend/$1.$2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/robots.txt",
      "dest": "frontend/robots.txt",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "frontend/sitemap.xml",
      "headers": {
        "Cache-Control": "public, max-age=21600",
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    {
      "src": "/blog-sitemap.xml",
      "dest": "frontend/blog-sitemap.xml",
      "headers": {
        "Cache-Control": "public, max-age=21600",
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    {
      "src": "/sitemap-index.xml",
      "dest": "frontend/sitemap-index.xml",
      "headers": {
        "Cache-Control": "public, max-age=21600",
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "frontend/manifest.json",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net fonts.googleapis.com www.googletagmanager.com www.google-analytics.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: https: blob: res.cloudinary.com www.google-analytics.com; connect-src 'self' https: www.google-analytics.com; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, private"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/sitemap/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=43200, s-maxage=86400"
        }
      ]
    }
  ]
}
