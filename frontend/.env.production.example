# Vercel production environment variables for frontend
# Set these in Vercel Project Settings -> Environment Variables

# Backend base URL (with or without /api; both are supported)
# Examples:
# REACT_APP_API_URL=https://asrvisuals-api.onrender.com
# REACT_APP_API_URL=https://asrvisuals-api.onrender.com/api
# REACT_APP_API_URL=https://api.asrvisuals.live
REACT_APP_API_URL=https://your-backend-domain.com

# Optional: public site URL used by analytics or SEO utilities
# REACT_APP_SITE_URL=https://asrvisuals.live

# Firebase Cloud Storage (optional, used by Admin Videos and Portfolio tab)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Google Forms integration for Contact Page (optional)
# Use formResponse endpoint, not viewform.
# Example:
# REACT_APP_GOOGLE_FORM_ACTION=https://docs.google.com/forms/d/e/<FORM_ID>/formResponse
# Each entry value is the exact field name from the Google Form HTML, e.g. entry.123456789
REACT_APP_GOOGLE_FORM_ACTION=
REACT_APP_GOOGLE_FORM_ENTRY_NAME=
REACT_APP_GOOGLE_FORM_ENTRY_EMAIL=
REACT_APP_GOOGLE_FORM_ENTRY_YOUTUBE=
REACT_APP_GOOGLE_FORM_ENTRY_PROJECT=
REACT_APP_GOOGLE_FORM_ENTRY_SERVICES=
